# Your Instantly API key — read server-side only, never exposed to the browser.
INSTANTLY_API_KEY=sk_...
# Optional: an admin-workspace key acts across client workspaces (agency mode).
# AS_WORKSPACE=<sub_workspace_id>
# Whitelabel — make it your portal.
# NEXT_PUBLIC_AGENCY_NAME=Meridian Outbound   # name shown in the sidebar
# NEXT_PUBLIC_ACCENT=#006bff                  # accent — recolors the whole UI
# NEXT_PUBLIC_LOGO=/logo.png                  # a logo in /public (drop your own there)

# Demo mode: fully populated with synthetic data (no key needed) — for a public demo.
# NEXT_PUBLIC_DEMO=1
