# Copy to .env and fill in. Never commit real secrets.
INSTANTLY_API_KEY=sk_...
# Shared secret you set on the reply webhook and verify on delivery (Instantly has no HMAC).
WEBHOOK_SECRET=change-me
# Port the service listens on.
PORT=3000
# Public URL of THIS service, used when registering the reply webhook (optional).
PUBLIC_URL=https://your-service.example.com
